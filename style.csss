
body {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.entrance {
 width: 375px;
  height: 812px;
  border-radius: 30px;
  overflow: hidden;
  position: relative;
  overflow: hidden;
}


video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}



.buttons {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
}

button{
 color: black;
 background-color: #FBB03B;
 font-size: 16px;
}